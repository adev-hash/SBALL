{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: compilar juego",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c17",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}\\principal.c",
                "${workspaceFolder}\\ui\\menu.c",
                "${workspaceFolder}\\ui\\fondo.c",
                "${workspaceFolder}\\ui\\animaciones.c",
                "${workspaceFolder}\\ui\\registro.c",
                "-o",
                "${workspaceFolder}\\main.exe",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos los módulos del juego en C17 con Raylib."
        }
    ],
    "version": "2.0.0"
}